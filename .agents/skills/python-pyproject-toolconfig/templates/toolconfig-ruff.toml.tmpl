[tool.ruff]
line-length = 100
target-version = "py${PYTHON_VERSION}"
fix = true

[tool.ruff.lint]
select = ["E","W","F","N","D","UP","B","A","C4","ARG","RUF"]
ignore = ["D100","D101","D102","D103","D104","D105"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["F401"]
"tests/**/*.py" = ["D","ARG"]
